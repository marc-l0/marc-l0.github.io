---
import "@fontsource-variable/onest";
import { profile } from "../data/portfolio";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";
import "../styles/freelance.css";
import "../styles/screens.css";
interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
}
const {
  title,
  description,
  type = "website",
  noindex = false,
  publishedTime,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og/portfolio.png", Astro.site);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  jobTitle: profile.role,
  email: profile.email,
  sameAs: [profile.github, profile.linkedin],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lima",
    addressCountry: "PE",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#141413" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:site_name"
      content="Axel Marcelo · Desarrollo Full Stack"
    />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Axel Marcelo: desarrollo Full Stack y soluciones digitales a medida"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Axel Marcelo: desarrollo Full Stack y soluciones digitales a medida"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(person).replace(/</g, "\\u003c")}
    />
    <meta property="og:locale" content="es_PE" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
