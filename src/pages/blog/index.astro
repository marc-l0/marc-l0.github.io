---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<Layout title="Blog" description="Artículos y novedades del blog">
  <main class="mx-auto max-w-4xl px-6 py-16">

    <header class="mb-16">
      <p class="mb-3 text-sm text-yellow-200/80">
        BLOG
      </p>

      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
        Artículos
      </h1>

      <p class="mt-4 max-w-2xl text-lg leading-8 text-neutral-400">
        Artículos sobre programación, proyectos y cosas que voy aprendiendo.
      </p>
    </header>

    <div>
      {posts.map((post) => (
        <article class="group border-t border-neutral-800 py-8">

          <a
            href={`/blog/${post.id}/`}
            class="block"
          >
            <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:gap-8">

              <span class="shrink-0 text-sm text-neutral-500">
                Artículo {post.data.number}
              </span>

              <div>
                <h2 class="text-2xl font-semibold tracking-tight transition group-hover:text-neutral-400">
                  {post.data.title}
                </h2>

                <p class="mt-2 text-neutral-400">
                  {post.data.description}
                </p>

                <p class="mt-4 text-sm text-neutral-600">
                  {post.data.pubDate.toLocaleDateString('es-PE', {
                    timeZone: 'UTC'
                  })}
                </p>
              </div>

            </div>
          </a>

        </article>
      ))}
    </div>

  </main>
</Layout>