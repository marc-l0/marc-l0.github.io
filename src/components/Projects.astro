---
const PROJECTS = [
    {
        title: "FirmaPE - Plataforma de Gestión y Firma Electrónica de Documentos",
        description:
            "Plataforma de firma electrónica y gestión documental que optimiza la aprobación y seguimiento de documentos mediante una aplicación móvil conectada a una API REST y base de datos SQL Server.",
        github: "https://github.com/Alevv27/App_tienda_massiel",
        image: "/projects/firmape.webp",
        tags: ["Kotlin", "Python", "Flask", "Microsoft SQL Server"],
    },
];
---

{
    PROJECTS.map(({ image, title, description, tags }) => (
        <article>
            <h3 class="text-2xl font-semibold text-yellow-200 mb-2">{title}</h3>
            <p class="text-lg mb-4 text-pretty">{description}</p>
            <ul class="flex flex-wrap gap-2 mb-4">
                {tags.map((tag) => (
                    <li class="bg-gray-800 text-gray-200 text-sm font-medium px-3 py-1 rounded-full">
                {tag}
                    </li>
                ))}
            </ul>
            <img
                class="rounded shadow-2xl shadow-white/10"
                src={image}
                alt={`Captura de pantalla del proyecto ${image}`}
            />
        </article>
    ))
}
