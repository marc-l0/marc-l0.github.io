---
import SectionHeading from "../ui/SectionHeading.astro";
import { workflow } from "../../data/services";
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const Subheading = standalone ? "h2" : "h3";
---

<section id="proceso" class="section container">
  <SectionHeading
    as={standalone ? "h1" : "h2"}
    number="05"
    eyebrow="Cómo trabajaremos"
    title="Un proceso claro, de principio a fin."
  />
  <p class="section-intro">
    Sabrás qué vamos a construir, cómo avanzamos y qué recibirás al terminar.
  </p>
  <ol class="workflow-grid">
    {workflow.map((step, index) => (
      <li>
        <span class="workflow-number">0{index + 1}</span>
        <Subheading>{step.title}</Subheading>
        <p>{step.description}</p>
      </li>
    ))}
  </ol>
</section>
