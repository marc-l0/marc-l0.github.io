---
import Pokeball from "../icons/Pokeball.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/marcelo.jpg";
import { profile } from "../../data/portfolio";
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span> {profile.role} ·{" "}
      {profile.location}
    </p>
    <h1 id="hero-title">
      Ideas claras.
      <br />
      Interfaces
      <br />
      <span>con propósito.</span>
    </h1>
    <p class="hero-description">
      Soy <strong>{profile.name}</strong>, desarrollador web en formación.
      Construyo aplicaciones y exploro cómo el diseño puede hacerlas más simples
      y útiles.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="#proyectos">
        Explorar proyectos <span aria-hidden="true">↘</span>
      </a>
      <a class="text-link" href={`mailto:${profile.email}`}>
        Ponte en contacto <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="hero-visual">
    <div class="portrait-frame">
      <Image
        src={portrait}
        alt="Retrato de Axel Marcelo"
        width={580}
        height={773}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="portrait-caption">
      <span>
        Siempre aprendiendo.
        <br />
        <strong>Siempre construyendo.</strong>
      </span>
      <Pokeball class="caption-symbol" />
    </div>
  </div>
  <div class="hero-bottom">
    <span>DESARROLLO + DISEÑO DE INTERFACES</span>
    <a href="#proyectos">
      Descubre mi trabajo <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
