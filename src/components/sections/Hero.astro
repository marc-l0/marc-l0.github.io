---
import Pokeball from "../icons/Pokeball.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/profile/marcelo.jpg";
import { profile } from "../../data/portfolio";
---

<section class="hero hero-freelance container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span> {profile.role} ·{" "}
      {profile.location}
    </p>
    <h1 id="hero-title">
      Desarrollo web
      <br />y soluciones
      <br />
      <span>a medida.</span>
    </h1>
    <p class="hero-description">
      Soy <strong>{profile.name}</strong>, desarrollador Full Stack. Ayudo a
      emprendedores y empresas a transformar sus ideas en páginas web,
      aplicaciones y sistemas digitales modernos, funcionales y escalables.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/contacto/">
        Hablemos de tu proyecto <span aria-hidden="true">↘</span>
      </a>
      <a class="text-link" href="/proyectos/">
        Ver proyectos <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="hero-visual">
    <div class="portrait-frame">
      <Image
        src={portrait}
        alt="Retrato de Axel Marcelo"
        width={580}
        height={773}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="portrait-caption">
      <span>
        Siempre aprendiendo.
        <br />
        <strong>Siempre construyendo.</strong>
      </span>
      <Pokeball class="caption-symbol" />
    </div>
  </div>
  <div class="hero-bottom">
    <span>FULL STACK · PROYECTOS FREELANCE</span>
    <a href="#explorar">
      Explora el portfolio <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
