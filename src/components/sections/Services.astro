---
import SectionHeading from "../ui/SectionHeading.astro";
import { services } from "../../data/services";
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const Subheading = standalone ? "h2" : "h3";
---

<section
  id="servicios"
  class="section container"
  aria-labelledby="services-title"
>
  <SectionHeading
    as={standalone ? "h1" : "h2"}
    number="01"
    eyebrow="Servicios"
    title="Lo que podemos construir."
    id="services-title"
  />
  <p class="section-intro">
    Desde la primera web de tu negocio hasta una aplicación para simplificar el
    trabajo de cada día.
  </p>
  <div class="service-grid">
    {services.map((service, index) => (
      <article class="service-card">
        <span class="eyebrow">0{index + 1} / A medida</span>
        <Subheading>{service.title}</Subheading>
        <p>{service.description}</p>
        <ul>
          {service.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
        <a
          class="text-link"
          href={`/contacto/?servicio=${service.id}#contacto`}
        >
          Consultar este servicio <span aria-hidden="true">→</span>
          <span class="sr-only">: {service.title}</span>
        </a>
      </article>
    ))}
  </div>
</section>
