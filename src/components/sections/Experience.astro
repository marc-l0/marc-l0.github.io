---
import { experience } from "../../data/portfolio";
import SectionHeading from "../ui/SectionHeading.astro";
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const Subheading = standalone ? "h2" : "h3";
---

<section id="experiencia" class="section container experience-section">
  <SectionHeading
    as={standalone ? "h1" : "h2"}
    number="03"
    eyebrow="Mi recorrido"
    title="Aprender haciendo."
  />
  <ol class="experience-list">
    {experience.map((item) => (
      <li class="experience-item">
        <div class="experience-period">
          <span
            class:list={["timeline-dot", { current: item.current }]}
            aria-hidden="true"
          ></span>
          {item.period}
        </div>
        <div>
          <p class="eyebrow">{item.organization}</p>
          <Subheading>{item.role}</Subheading>
          <p>{item.description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
