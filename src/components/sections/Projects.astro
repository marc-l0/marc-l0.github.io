---
import { Image } from "astro:assets";
import { profile } from "../../data/portfolio";
import { projects } from "../../data/projects";
import ProjectCTA from "../ui/ProjectCTA.astro";
import SectionHeading from "../ui/SectionHeading.astro";
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const Subheading = standalone ? "h2" : "h3";
---

<section id="proyectos" class="section container">
  <div class="section-top">
    <SectionHeading
      as={standalone ? "h1" : "h2"}
      number="02"
      eyebrow="Proyectos destacados"
      title="De la idea a la práctica."
    />
    <a
      class="text-link"
      href={profile.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      Más en GitHub ↗
    </a>
  </div>
  {projects.map((project, index) => (
    <article class="project">
      <div
        class:list={[
          "project-image",
          { "project-image--screens": project.secondaryImage },
        ]}
      >
        <span class="project-index">{String(index + 1).padStart(2, "0")}</span>
        <Image
          src={project.image}
          alt={project.imageAlt}
          widths={project.secondaryImage ? [240, 480] : [480, 960, 1440]}
          sizes={
            project.secondaryImage
              ? "(max-width:700px) 40vw, 170px"
              : "(max-width:700px) 90vw, (max-width:1000px) 50vw, 640px"
          }
          loading="lazy"
        />
        {project.secondaryImage && (
          <Image
            src={project.secondaryImage}
            alt={project.secondaryImageAlt ?? project.title}
            widths={[240, 480]}
            sizes="(max-width:700px) 40vw, 170px"
            loading="lazy"
          />
        )}
      </div>
      <div class="project-content">
        <p class="eyebrow">{project.category}</p>
        <Subheading>{project.title}</Subheading>
        {project.status && <p class="project-status">{project.status}</p>}
        <p>{project.description}</p>
        <dl class="project-context">
          <div>
            <dt>Necesidad</dt>
            <dd>{project.problem}</dd>
          </div>
          <div>
            <dt>Solución</dt>
            <dd>{project.solution}</dd>
          </div>
          {project.participation && (
            <div>
              <dt>Mi participación</dt>
              <dd>{project.participation}</dd>
            </div>
          )}
        </dl>
        <ul class="project-features" aria-label="Funcionalidades destacadas">
          {project.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
        <ul class="tags" aria-label="Tecnologías">
          {project.technologies.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <div class="project-actions">
          <a class="text-link" href="/contacto/?servicio=full-stack#contacto">
            Consultar una solución similar
            <span class="sr-only"> a {project.title}</span> ↗
          </a>
          {project.details && (
            <a class="text-link" href={project.details}>
              Explorar el proyecto ↗
            </a>
          )}
          {project.source && (
            <a
              class="text-link"
              href={project.source}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver código ↗
            </a>
          )}
        </div>
      </div>
    </article>
  ))}
  <ProjectCTA />
</section>
