---
import { Image } from "astro:assets";
import { projects, profile } from "../../data/portfolio";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="proyectos" class="section container">
  <div class="section-top">
    <SectionHeading
      number="01"
      eyebrow="Trabajo seleccionado"
      title="De la idea a la práctica."
    />
    <a
      class="text-link"
      href={profile.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      Más en GitHub ↗
    </a>
  </div>
  {projects.map((project, index) => (
    <article class="project">
      <div
        class:list={[
          "project-image",
          { "project-image--screens": project.secondaryImage },
        ]}
      >
        <span class="project-index">{String(index + 1).padStart(2, "0")}</span>
        {project.image ? (
          <>
            {typeof project.image === "string" ? (
              <img
                src={project.image}
                alt={project.imageAlt ?? project.title}
                loading="lazy"
                width="1200"
                height="720"
              />
            ) : (
              <Image
                src={project.image}
                alt={project.imageAlt ?? project.title}
                widths={[240, 480]}
                sizes="(max-width:700px) 40vw, 170px"
                loading="lazy"
              />
            )}
            {project.secondaryImage && (
              <Image
                src={project.secondaryImage}
                alt={project.secondaryImageAlt ?? project.title}
                widths={[240, 480]}
                sizes="(max-width:700px) 40vw, 170px"
                loading="lazy"
              />
            )}
          </>
        ) : (
          <div class="project-cover">
            <span class="eyebrow">{project.category}</span>
            <span class="project-cover-title">
              {project.title}
              <span aria-hidden="true">.</span>
            </span>
            {project.coverTagline && <p>{project.coverTagline}</p>}
            <span class="project-cover-label">{project.status}</span>
          </div>
        )}
      </div>
      <div class="project-content">
        <p class="eyebrow">{project.category}</p>
        <h3>{project.title}</h3>
        {project.status && <p class="project-status">{project.status}</p>}
        <p>{project.description}</p>
        <ul class="tags" aria-label="Tecnologías">
          {project.technologies.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <div class="project-actions">
          {project.details && (
            <a class="text-link" href={project.details}>
              Explorar el proyecto ↗
            </a>
          )}
          {project.source && (
            <a
              class="text-link"
              href={project.source}
              target="_blank"
              rel="noopener noreferrer"
            >
              Ver código ↗
            </a>
          )}
        </div>
      </div>
    </article>
  ))}
</section>
