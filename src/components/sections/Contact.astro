---
import { profile } from "../../data/portfolio";
import QuoteForm from "../forms/QuoteForm.astro";
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const Heading = standalone ? "h1" : "h2";
---

<section
  id="contacto"
  class="contact-section container"
  aria-labelledby="contact-title"
>
  <div class="contact-heading">
    <p class="eyebrow">Tu próximo proyecto empieza aquí</p>
    <Heading id="contact-title">
      Hablemos de
      <br />
      <span>tu proyecto.</span>
    </Heading>
    <p class="section-intro">
      Cuéntame la idea, el reto o lo que necesitas mejorar. A partir de ahí,
      podemos definir una solución y una propuesta a medida.
    </p>
    <p class="quote-note">
      Cada proyecto se cotiza de manera personalizada según sus funcionalidades,
      complejidad y alcance.
    </p>
  </div>
  <div class="contact-grid">
    <aside class="contact-details" aria-label="Otras formas de contacto">
      <p class="eyebrow">Contacto directo</p>
      <a class="contact-email" href={`mailto:${profile.email}`}>
        {profile.email} <span aria-hidden="true">↗</span>
      </a>
      <p>Disponible para proyectos freelance en Perú y de forma remota.</p>
      <div class="social-links">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn ↗
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
    </aside>
    <QuoteForm />
  </div>
</section>
